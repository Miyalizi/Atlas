---
// 关于页：开头一张“印样”（contact sheet），把几篇代表作排成一条胶片，然后是 about.md 的正文
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getGraph, TYPES, typeOf, urlOf } from '../lib/content';
import { coverPath } from '../lib/cover';

// 想换印样里的文章，改这里的 id 即可（需要是带封面的长文章或项目）
const PICKS = ['posts/ai-darkroom', 'posts/harness-engineering', 'projects/contact-sheet', 'posts/indie-pricing', 'posts/ai-reading-map', 'posts/fed-dot-plot'];

const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
const { byId } = await getGraph();
const picks = PICKS.map((id) => byId.get(id)).filter((e) => !!e);
---
<Base title={page.data.title} description={page.data.description}>
  <div class="wrap">
    <section class="post-head">
      <div></div>
      <div>
        <h1>你好，我是 Lizi<em class="dot">.</em></h1>
        <p class="dek">{page.data.description}</p>
      </div>
    </section>

    <section class="sheet" aria-labelledby="sheet-title">
      <div class="sheet-head">
        <h2 id="sheet-title">从这里开始读</h2>
        <span class="label">Contact sheet · {picks.length} 帧</span>
      </div>
      <ol class="film">
        {picks.map((e, i) => (
          <li>
            <a href={urlOf(e)}>
              <span class="edge tnum" aria-hidden="true"><span>{i + 1}</span><span>{i + 1}A</span><span>ATLAS 400</span></span>
              <span class="frame"><img src={coverPath(e, 'dark')} alt="" width="1200" height="630" loading="lazy" decoding="async" /></span>
              <span class="cap"><span class="label">{TYPES[typeOf(e)].name}</span><b>{e.data.title}</b></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="post-body">
      <div></div>
      <article class="prose"><Content /></article>
    </section>
  </div>
</Base>
