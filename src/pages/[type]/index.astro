---
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getGraph, TYPES, TYPE_KEYS, typeOf, type TypeKey } from '../../lib/content';

export function getStaticPaths() {
  return TYPE_KEYS.map((type) => ({ params: { type } }));
}
const type = Astro.params.type as TypeKey;
const { entries } = await getGraph();
const list = entries.filter((e) => typeOf(e) === type);
// 按月分组，大量同一时期的内容不再是一长串重复的日期
const months = new Map<string, typeof list>();
for (const e of list) {
  const k = `${e.data.date.getFullYear()} 年 ${e.data.date.getMonth() + 1} 月`;
  if (!months.has(k)) months.set(k, []);
  months.get(k)!.push(e);
}
const intro: Record<TypeKey, string> = {
  posts: '花了时间想清楚、写完整的东西。',
  notes: '想到就记下的片段，可能以后会长成文章。',
  media: '读过的书、看过的电影、玩过的游戏，以及当时的想法。',
  projects: '做过和正在做的东西。',
  links: '值得反复回看的网页、论文和工具。',
};
---
<Base title={TYPES[type].name} description={intro[type]}>
  <div class="wrap">
    <header class="page-head">
      <h1>{TYPES[type].name}</h1>
      <p>{intro[type]}</p>
    </header>
    <div class="section-head"><h2 class="sans">全部</h2><span class="count tnum">{list.length} 条</span></div>
    {[...months].map(([m, items]) => (
      <section>
        <h3 class="month tnum">{m}<small>{items.length} 条</small></h3>
        <ul class="list">{items.map((e) => <EntryRow entry={e} />)}</ul>
      </section>
    ))}
    {!list.length && <p class="empty-note">这里还没有内容。在 <code>src/content/{type}/</code> 里新建一个 Markdown 文件就会出现在这里。</p>}
  </div>
</Base>
