---
// MDX 里可用的提示框：<Aside title="注意">内容</Aside>
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="aside">
  {title && <strong>{title}</strong>}
  <slot />
</aside>
<style>
  .aside { margin: 1.8em 0; padding: 14px 18px; background: var(--paper-2); border-radius: 6px; font-size: var(--fs-base); line-height: 1.8; }
  .aside strong { display: block; font-family: var(--sans); font-size: var(--fs-sm); color: var(--accent); margin-bottom: 4px; }
  .aside :global(p) { margin: 0; }
</style>
